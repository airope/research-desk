# Local Compose values only. Do not deploy these demonstration credentials.
PGPASSWORD=srr-local-only
SECRET_KEY=local-demo-only-change-before-deployment

# Optional trusted-local research assistant (never enable for public deployment)
RESEARCH_CODEX_ENABLED=0
RESEARCH_LOCAL_USER=reviewer

# Passage retrieval: local or elasticsearch. Credentials stay server-side.
RESEARCH_SEARCH_BACKEND=local
RESEARCH_ELASTICSEARCH_URL=http://elasticsearch:9200
RESEARCH_ELASTICSEARCH_API_KEY=
RESEARCH_ELASTICSEARCH_READ_API_KEY=
RESEARCH_ELASTICSEARCH_CA_CERTS=

# Required only by compose.search.yaml. Use a unique generated password locally.
RESEARCH_ELASTIC_PASSWORD=
# Native Python loads the project .env; process environment takes precedence.
# Production (injected by your deployment system, not this local Compose):
# APP_ENV=production
# DEBUG=0
# ALLOWED_HOSTS=research.example.org
# TRUST_HTTPS_PROXY=1
# CSRF_TRUSTED_ORIGINS=https://research.example.org

# Explicit LLM choice: codex (default), openai, anthropic, gemini, mistral,
# deepseek, groq, xai, openrouter, openai_compatible. Never auto-falls back.
LLM_PROVIDER=codex
# Empty = the provider default documented in docs/llm-providers.md.
LLM_MODEL=
# Either this generic key OR the selected provider's key below is sufficient.
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Custom provider only; HTTPS required except loopback during development.
LLM_BASE_URL=
# Empty = provider default. Optional json_object / json_schema for compatible APIs.
LLM_OUTPUT_MODE=
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=180
